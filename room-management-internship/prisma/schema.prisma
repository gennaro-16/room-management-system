// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  floor       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
 
  // Department resources
  rooms       Room[]
  users       User[]
}

model Room {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  capacity    Int
  description String?
  amenities   String[]    // e.g., ["projector", "whiteboard", "video-conference"]
  
  // Location tracking
  floor       Int
  building    String      @default("Main")
  x           Int?
  y           Int?
  width       Int?
  height      Int?
  
  // Department association
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  // Status management
  isUnderMaintenance Boolean @default(false)
  maintenanceNotes   String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED  // by the user
  COMPLETED
  ONGOING
}

model Booking {
  id         Int            @id @default(autoincrement())
  title      String         // Meeting title
  roomId     Int
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  organizerId Int           // The person who created the booking
  organizer  User           @relation("BookingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Participants
  expectedAttendees Int     // To compare with room capacity
  internalAttendees String[] // Names of internal participants
  externalAttendees String[] // Names of external participants
  
  // Meeting details
  purpose    String
  agenda     String?
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus  @default(PENDING)
  isRecurring Boolean       @default(false)
  recurrenceRule String?    // e.g., "RRULE:FREQ=WEEKLY;INTERVAL=1"
  
  // Resources needed
  requiredAmenities String[]
  
  // Approval tracking
  approvedById Int?
  approvedBy   User?     @relation("BookingApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectedById Int?
  rejectedBy   User?     @relation("BookingRejecter", fields: [rejectedById], references: [id])
  rejectedAt   DateTime?
  rejectionReason String?
  
  // For recurring bookings
  parentBookingId Int?
  parentBooking   Booking?   @relation("RecurringBookings", fields: [parentBookingId], references: [id])
  childBookings   Booking[]  @relation("RecurringBookings")
  
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  notifications Notification[]
  
  @@index([startTime, endTime])
  @@index([status])
}

enum UserRole {
  ADMIN
  EMPLOYEE
  GUEST
}

model User {
  id        Int       @id @default(autoincrement())
  employeeId String   @unique // Bank employee ID
  username  String    @unique
  email     String    @unique
  password  String    // hashed password
  role      UserRole  @default(EMPLOYEE)
  
  // Personal information
  firstName String
  lastName  String
  title     String?   // Job title
  phone     String?
  
  // Department association
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  // Status
  isActive     Boolean   @default(true)
  isApproved   Boolean   @default(true)
  
  // Approval tracking
  approvedById Int?
  approvedBy   User?     @relation("UserApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectedById Int?
  rejectedBy   User?     @relation("UserRejecter", fields: [rejectedById], references: [id])
  rejectedAt   DateTime?
  rejectionReason String?
  
  // Reverse relations for approval tracking
  approvedUsers User[] @relation("UserApprover")
  rejectedUsers User[] @relation("UserRejecter")
  
  // Relations
  organizedBookings Booking[] @relation("BookingOrganizer")
  // attendingBookings relation removed; internal attendees now stored as names on Booking
  approvedBookings  Booking[] @relation("BookingApprover")
  rejectedBookings  Booking[] @relation("BookingRejecter")
  notifications Notification[]
  
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Notification system for booking updates
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  relatedBookingId Int?
  relatedBooking Booking? @relation(fields: [relatedBookingId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum NotificationType {
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_REMINDER
  ROOM_MAINTENANCE
  NEW_BOOKING_REQUEST // For approvers
}