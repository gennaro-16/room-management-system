# ---- Database ----
POSTGRES_DB=room_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Connection string used by the backend (Prisma)
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/room_management

# ---- Auth ----
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=24h

# ---- URLs ----
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---- Ports ----
BACKEND_PORT=3000
FRONTEND_PORT=3001
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---- Optional: Redis ----
REDIS_URL=redis://redis:6379
